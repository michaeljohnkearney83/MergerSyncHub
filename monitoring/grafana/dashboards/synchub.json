              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Resilience events (retries, circuit breaker)",
      "description": "Polly events from the Firm B resilience pipeline: OnRetry, OnCircuitOpened, OnTimeout...",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event_name) (increase(resilience_polly_strategy_events_total{event_name!~\"PipelineExecuting|PipelineExecuted\"}[5m]))",
          "legendFormat": "{{event_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
