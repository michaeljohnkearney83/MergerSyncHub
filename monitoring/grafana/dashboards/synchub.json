    {
      "type": "row",
      "title": "Logs (Loki)",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Warnings and errors, all services",
      "description": "Expand a line to see Source, CorrelationId and SyncRunId. Paste a CorrelationId from the dashboard's run history into the variable above to see one run end to end.",
      "id": 20,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$service\"} | severity_text=~\"Warning|Error|Critical\" | CorrelationId=~\"$correlation\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "type": "logs",
      "title": "All logs",
      "description": "",
      "id": 21,
      "datasource": {
        "type": "loki",
