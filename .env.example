# Copy to .env (Git ignores it) and choose your own password.
# Used by docker-compose.yml for SQL Server and, in the "app" profile, for the services' connection strings.
# SQL Server only reads it when its data volume is first created.
MSSQL_SA_PASSWORD=ChangeMe-Str0ng!Passw0rd
# Read-only login for Power BI and SSRS (synchub_reporting). Optional; choose your own.
REPORTING_SQL_PASSWORD=ChangeMe-Rep0rting!Passw0rd
