{
  "ConnectionStrings": {
    "SyncHub": "Server=localhost;Database=SyncHub;Trusted_Connection=True;TrustServerCertificate=True;Application Name=SyncHub.Worker",
    "FirmA": "Server=localhost;Database=FirmA_Legacy;Trusted_Connection=True;TrustServerCertificate=True;Application Name=SyncHub.Worker;ApplicationIntent=ReadOnly"
  },
  "Sync": {
    "IntervalSeconds": 60,
    "LookbackMinutes": 5,
    "BatchSize": 5000,
    "DuplicateThreshold": 0.92,
    "ReportingRefreshMinutes": 5,
    "StagingRetentionDays": 2,
    "RunHistorySucceededDays": 90,
    "RunHistoryOtherDays": 365,
    "HealthSnapshotMinutes": 2
  },
  "FirmB": {
    "BaseUrl": "http://localhost:5070/",
    "ApiKey": "demo-key-123",
    "PageSize": 500
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:14317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  }
}
